{
  "name": "codex-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun run --bun next dev",
    "build": "bun run --bun next build",
    "start": "bun run --bun next start",
    "db:migrate": "bun scripts/migrate.ts",
    "db:migrate:up": "bun scripts/migrate.ts up",
    "db:migrate:down": "bun scripts/migrate.ts down",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:prepare": "bun scripts/prepare-e2e.ts",
    "test:e2e": "bun run test:e2e:prepare && bun run build && playwright test",
    "lint": "oxlint",
    "format": "oxfmt . '!**/.agents/**' '!**/.codex/**'"
  },
  "dependencies": {
    "@openai/codex": "^0.136.0",
    "@tiptap/core": "^3.31.3",
    "@tiptap/html": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "better-auth": "^1.6.9",
    "next": "16.1.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.3.13",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.0.0",
    "eslint-config-next": "16.1.6",
    "jsdom": "^30.1.0",
    "oxfmt": "^0.33.0",
    "oxlint": "^1.48.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.1"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
